{
  "name": "llm-pk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:public-snapshot": "esbuild scripts/generatePublicLeaderboardSnapshot.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-generate-public-snapshot.mjs && node /tmp/llmpk-generate-public-snapshot.mjs",
    "generate:price-tiers": "esbuild scripts/generatePriceTierSnapshot.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-generate-price-tiers.mjs && node /tmp/llmpk-generate-price-tiers.mjs",
    "verify:public-bundle": "node scripts/verifyPublicBundle.mjs",
    "build": "npm run generate:public-snapshot && npm run generate:price-tiers && tsc -b && vite build && npm run verify:public-bundle",
    "test": "npm run test:source-extraction && npm run test:scoring-v3 && npm run test:scoring && npm run test:custom-ranking && npm run test:pareto && npm run test:price-tiers && npm run test:admin-mapping && npm run test:scope && npm run test:detail-content && npm run test:play-mode && npm run test:openrouter-pricing && npm run test:openrouter-speed && npm run test:openrouter-benchmarks && npm run test:design-arena && npm run test:vals && npm run test:october-models && npm run test:october24-models && npm run test:scoring-v32 && npm run test:source-expansion && npm run test:practical",
    "test:source-extraction": "node scripts/sourceExtraction.test.mjs",
    "test:scoring": "esbuild scripts/scoringEngine.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-scoring-engine.test.mjs && node /tmp/llmpk-scoring-engine.test.mjs",
    "test:custom-ranking": "esbuild scripts/customRanking.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-custom-ranking.test.mjs && node /tmp/llmpk-custom-ranking.test.mjs",
    "test:pareto": "esbuild scripts/pareto.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-pareto.test.mjs && node /tmp/llmpk-pareto.test.mjs",
    "test:price-tiers": "esbuild scripts/priceTiers.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-price-tiers.test.mjs && node /tmp/llmpk-price-tiers.test.mjs",
    "test:admin-mapping": "esbuild scripts/adminMappingStore.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-admin-mapping-store.test.mjs && node /tmp/llmpk-admin-mapping-store.test.mjs",
    "test:scope": "esbuild scripts/oagxmScope.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-oagxm-scope.test.mjs && node /tmp/llmpk-oagxm-scope.test.mjs",
    "test:detail-content": "esbuild scripts/configurationDetailContent.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-configuration-detail-content.test.mjs && node /tmp/llmpk-configuration-detail-content.test.mjs",
    "test:play-mode": "esbuild scripts/playModeQueue.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-play-mode-queue.test.mjs && node /tmp/llmpk-play-mode-queue.test.mjs",
    "test:openrouter-pricing": "esbuild scripts/openRouterPromotionalPricing.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-openrouter-promotional-pricing.test.mjs && node /tmp/llmpk-openrouter-promotional-pricing.test.mjs",
    "test:openrouter-speed": "node scripts/openRouterSpeedStabilization.test.mjs && node scripts/openRouterEndpointPolicy.test.mjs",
    "test:design-arena": "node scripts/designArenaSnapshot.test.mjs && esbuild scripts/designArenaIntegration.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-design-arena-integration.test.mjs && node /tmp/llmpk-design-arena-integration.test.mjs",
    "test:openrouter-benchmarks": "node scripts/openRouterBenchmarkSnapshot.test.mjs",
    "audit:arena": "node scripts/arena_data_self_audit.mjs",
    "audit:scoring": "esbuild scripts/scoringSnapshotAudit.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-scoring-snapshot-audit.mjs && node /tmp/llmpk-scoring-snapshot-audit.mjs",
    "audit:profile-matches": "esbuild scripts/sourceProfileMatchAudit.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-source-profile-match-audit.mjs && node /tmp/llmpk-source-profile-match-audit.mjs",
    "audit:config-coverage": "esbuild scripts/configurationCoverageAudit.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-configuration-coverage-audit.mjs && node /tmp/llmpk-configuration-coverage-audit.mjs",
    "refresh:source-snapshots": "node scripts/refreshSourceSnapshots.mjs",
    "rebuild:source-catalog": "OPENROUTER_MODELS_SNAPSHOT_PATH=src/data/openRouterCatalogSnapshot.json node scripts_build_all_3_sources_catalog.js",
    "refresh:artificial-analysis": "node scripts/fetchArtificialAnalysisSnapshot.mjs",
    "refresh:arena": "node scripts/fetchArenaSnapshots.mjs",
    "refresh:openrouter-catalog": "node scripts/fetchOpenRouterCatalogSnapshot.mjs",
    "refresh:openrouter-performance": "node scripts/fetchOpenRouterPerformanceSnapshot.mjs",
    "refresh:openrouter-benchmarks": "node scripts/fetchOpenRouterBenchmarkSnapshot.mjs",
    "refresh:design-arena": "node scripts/fetchDesignArenaSnapshot.mjs",
    "refresh:vals": "node scripts/fetchValsSnapshot.mjs",
    "test:vals": "node scripts/valsSnapshot.test.mjs && esbuild scripts/valsIntegration.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-vals-integration.test.mjs && node /tmp/llmpk-vals-integration.test.mjs",
    "validate:source-snapshots": "node scripts/validateSourceSnapshots.mjs",
    "preview": "vite preview",
    "test:scoring-v3": "esbuild scripts/scoringV3Policies.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-scoring-v3.test.mjs && node /tmp/llmpk-scoring-v3.test.mjs",
    "refresh:frontiercode": "node scripts/fetchFrontierCodeSnapshot.mjs",
    "test:october-models": "esbuild scripts/octoberModelRefresh.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-october-model-refresh.test.mjs && node /tmp/llmpk-october-model-refresh.test.mjs",
    "test:october24-models": "esbuild scripts/october24ModelRefresh.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-october24-model-refresh.test.mjs && node /tmp/llmpk-october24-model-refresh.test.mjs",
    "test:scoring-v32": "esbuild scripts/scoringV32Expansion.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-scoring-v32.test.mjs && node /tmp/llmpk-scoring-v32.test.mjs",
    "refresh:source-expansion": "node scripts/fetchSourceExpansionSnapshot.mjs",
    "test:source-expansion": "node scripts/sourceExpansionSnapshot.test.mjs && esbuild scripts/sourceExpansionIntegration.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-source-expansion.test.mjs && node /tmp/llmpk-source-expansion.test.mjs",
    "test:practical": "esbuild scripts/practicalAdjustment.test.ts --bundle --platform=node --format=esm --outfile=/tmp/llmpk-practical-adjustment.test.mjs && node /tmp/llmpk-practical-adjustment.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.1.0"
  }
}
